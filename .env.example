# =============================================================================
# Proposal Writing SaaS - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# =============================================================================

# =============================================================================
# Application
# =============================================================================

NODE_ENV=development
# Options: development, production, test

OPEN_AGENT_SERVER_EXTERNAL_URL=http://localhost:8080
# External URL where the server is accessible
# Production example: https://api.yourproposalsaas.com

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================

DATABASE_URL=postgresql://openagent:openagent_password@localhost:5432/openagent
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Docker: postgresql://openagent:openagent_password@postgres:5432/openagent
# Production: Use connection pooling (PgBouncer) for better performance

# =============================================================================
# Redis (Caching and Job Queue)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave password empty for local development
# Production: Use strong password

REDIS_DB=0
# Database number (0-15)

# =============================================================================
# AI Providers (REQUIRED)
# =============================================================================

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Get your key from: https://console.anthropic.com/
# Used for: Multi-agent proposal generation, compliance checking
# Required: YES (core feature)

OPENAI_API_KEY=sk-your-openai-api-key-here
# Get your key from: https://platform.openai.com/
# Used for: Document embeddings (RAG), semantic search
# Required: NO (optional, for production RAG)
# If not set, embeddings will use placeholder mode

# =============================================================================
# External Grant APIs (OPTIONAL)
# =============================================================================

GRANTS_GOV_API_KEY=your-grants-gov-api-key
# Get your key from: https://www.grants.gov/
# Used for: Fetching federal grant opportunities
# Required: NO (optional feature)

FOUNDATION_DIRECTORY_API_KEY=your-foundation-directory-key
# Get your key from: https://candid.org/
# Used for: Fetching private foundation grant opportunities
# Required: NO (optional feature)

# =============================================================================
# Authentication & Security
# =============================================================================

JWT_SECRET=change-this-to-a-strong-random-secret-in-production
# Generate strong secret: openssl rand -base64 32
# Used for: JWT token signing
# IMPORTANT: Change this in production!

JWT_EXPIRATION=7d
# Token expiration time
# Options: 1h, 24h, 7d, 30d

SESSION_SECRET=another-strong-random-secret-for-sessions
# Generate: openssl rand -base64 32
# Used for: Session management

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

CORS_ORIGIN=http://localhost:3000,http://localhost:8080
# Comma-separated list of allowed origins
# Production example: https://app.yourproposalsaas.com,https://yourproposalsaas.com

CORS_CREDENTIALS=true
# Allow credentials (cookies, authorization headers)

# =============================================================================
# Rate Limiting
# =============================================================================

RATE_LIMIT_TTL=60
# Time window in seconds

RATE_LIMIT_MAX=100
# Maximum requests per time window per IP

# AI-specific rate limits (more restrictive)
AI_RATE_LIMIT_TTL=60
AI_RATE_LIMIT_MAX=10
# Limit AI generation requests to prevent abuse

# =============================================================================
# File Upload
# =============================================================================

MAX_FILE_SIZE=10485760
# Maximum file size in bytes (default: 10MB)
# 10MB = 10485760, 50MB = 52428800

UPLOAD_DIR=./uploads
# Directory for file uploads
# Production: Use cloud storage (S3, GCS, Azure Blob)

# =============================================================================
# Email (for notifications)
# =============================================================================

SMTP_HOST=smtp.gmail.com
# SMTP server hostname

SMTP_PORT=587
# SMTP port (usually 587 for TLS, 465 for SSL)

SMTP_SECURE=false
# Use SSL/TLS (true for port 465, false for 587)

SMTP_USER=your-email@gmail.com
# SMTP username (usually your email)

SMTP_PASSWORD=your-app-password
# SMTP password or app-specific password
# Gmail: https://support.google.com/accounts/answer/185833

EMAIL_FROM=no-reply@yourproposalsaas.com
# From address for outgoing emails

# =============================================================================
# Logging & Monitoring
# =============================================================================

LOG_LEVEL=info
# Options: error, warn, info, debug, verbose

LOG_FORMAT=json
# Options: json, simple, pretty

ENABLE_QUERY_LOGGING=false
# Log all database queries (useful for debugging)
# WARNING: Produces large logs in production

# Sentry (Error Tracking)
SENTRY_DSN=
# Get from: https://sentry.io/
# Optional: For production error tracking

# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_AI_GENERATION=true
# Enable/disable AI proposal generation

ENABLE_GRANT_SYNC=true
# Enable/disable automatic grant syncing

ENABLE_EMBEDDINGS=true
# Enable/disable document embeddings (RAG)

ENABLE_EMAIL_NOTIFICATIONS=true
# Enable/disable email notifications

# =============================================================================
# Development & Testing
# =============================================================================

# Bypass authentication (DEVELOPMENT ONLY!)
DEV_SKIP_AUTH=false
# WARNING: Never enable in production!

# Mock AI responses (for testing without API keys)
MOCK_AI_RESPONSES=false
# Returns placeholder content instead of calling AI APIs

# Database seeding
AUTO_SEED_DATABASE=false
# Automatically seed database on startup (development only)

# =============================================================================
# Performance & Optimization
# =============================================================================

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
# Adjust based on expected load

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=20

# AI Request Timeout
AI_REQUEST_TIMEOUT=120000
# Timeout in milliseconds (default: 2 minutes)

# Embedding Batch Size
EMBEDDING_BATCH_SIZE=50
# Number of documents to process in parallel

# =============================================================================
# Cloud Storage (Optional - for production file uploads)
# =============================================================================

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_KEYFILE=./service-account-key.json
GCS_BUCKET=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# =============================================================================
# Analytics & Metrics (Optional)
# =============================================================================

# Mixpanel
MIXPANEL_TOKEN=
# Get from: https://mixpanel.com/

# Google Analytics
GA_TRACKING_ID=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# Payment Processing (Optional - for SaaS)
# =============================================================================

# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: https://stripe.com/

# =============================================================================
# Webhooks (Optional)
# =============================================================================

WEBHOOK_SECRET=your-webhook-signing-secret
# Used to verify webhook signatures

# Slack Notifications
SLACK_WEBHOOK_URL=
# Get from: https://api.slack.com/messaging/webhooks

# =============================================================================
# Advanced Configuration
# =============================================================================

# GraphQL
GRAPHQL_PLAYGROUND=true
# Enable GraphQL Playground UI (disable in production)

GRAPHQL_INTROSPECTION=true
# Enable schema introspection (disable in production)

# AI Model Selection
AI_MODEL_RESEARCH=claude-3-5-sonnet-20241022
AI_MODEL_WRITING=claude-3-5-sonnet-20241022
AI_MODEL_COMPLIANCE=claude-3-5-sonnet-20241022
# Override default models per agent type

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large
# OpenAI embedding model

EMBEDDING_DIMENSIONS=1024
# Vector dimensions (must match database schema)

# =============================================================================
# Notes
# =============================================================================
#
# 1. Never commit this file with actual secrets to version control
# 2. Use environment-specific .env files (.env.development, .env.production)
# 3. In production, use secret management (AWS Secrets Manager, HashiCorp Vault)
# 4. Rotate secrets regularly
# 5. Monitor for exposed secrets with tools like git-secrets or truffleHog
#
# =============================================================================
